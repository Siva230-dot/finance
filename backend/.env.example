# ---- Application ----
APP_ENV=development            # development | production | test
APP_NAME=AI_FinanceMate
LOG_LEVEL=INFO

# ---- Groq LLM (server-side only, never expose to the frontend) ----
GROQ_API_KEY=                  # https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-120b # verified active on Groq production models, Nov 2026
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2

# ---- Database (PostgreSQL) ----
# Local:    postgresql+psycopg://postgres@localhost:5432/financemate
# Supabase: postgresql+psycopg://postgres.<ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
DATABASE_URL=
TEST_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/financemate_test

# ---- Auth ----
JWT_SECRET_KEY=                # generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Web ----
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173   # comma separated allowlist
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_DEFAULT=120/minute
